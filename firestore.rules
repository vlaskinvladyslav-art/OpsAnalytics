rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function hasRole(roles) {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in roles;
    }

    // User profiles: users can read their own profile.
    // Management roles can read profiles for analytics.
    match /users/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid ||
        hasRole(['admin', 'director'])
      );
      allow write: if hasRole(['admin']);
    }

    // Master data
    match /employees/{employeeId} {
      allow read: if hasRole(['admin', 'director', 'manager', 'analyst']);
      allow write: if hasRole(['admin', 'director']);
    }

    match /processes/{processId} {
      allow read: if hasRole(['admin', 'director', 'manager', 'analyst']);
      allow write: if hasRole(['admin', 'director']);
    }

    // Aggregated analytics.
    match /analyticsMonthly/{periodId} {
      allow read: if hasRole(['admin', 'director', 'manager', 'analyst']);
      allow write: if hasRole(['admin', 'director']);
    }

    match /processMetrics/{metricId} {
      allow read: if hasRole(['admin', 'director', 'manager', 'analyst']);
      allow write: if hasRole(['admin', 'director']);
    }

    match /employeeMetrics/{metricId} {
      allow read: if hasRole(['admin', 'director', 'manager', 'analyst']);
      allow write: if hasRole(['admin', 'director']);
    }

    // Default deny.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
